        "jsonBody": "={\n  \"model\": \"deepseek/deepseek-chat\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Ты классифицируешь заявку клиента. Верни только валидный JSON без markdown и пояснений в формате: {\\\"summary\\\":\\\"краткое содержание заявки\\\",\\\"direction\\\":\\\"направление заявки\\\"}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"={{ $json.request }}\"\n    }\n  ],\n  \"temperature\": 0.2\n}",
        "options": {}
