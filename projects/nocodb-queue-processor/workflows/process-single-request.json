    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.choices?.[0]?.message?.content ?? '';\n\nconst cleaned = raw\n  .replace(/^```(?:json)?\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .trim();\n\nlet result;\n\ntry {\n  result = JSON.parse(cleaned);\n} catch (error) {\n  throw new Error(`Не удалось распарсить ответ ИИ: ${raw}`);\n}\n\nconst source = $('Start').item.json;\n\nreturn {\n  json: {\n    source_id: source.source_id,\n    summary: result.summary,\n    direction: result.direction,\n  },\n};"
      },
