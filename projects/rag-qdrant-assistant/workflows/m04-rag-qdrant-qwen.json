                  {
                      "parameters":  {
                                         "jsCode":  "const text = $input.first().json.document_text;\n\nconst chunkSize = 1200;\nconst overlap = 100;\nconst chunks = [];\n\nfor (\n  let start = 0, index = 0;\n  start \u003c text.length;\n  start += chunkSize - overlap, index++\n) {\n  const chunk = text\n    .slice(start, start + chunkSize)\n    .trim();\n\n  chunks.push({\n    json: {\n      chunk_id: index + 1,\n      chunk_text: chunk,\n      source: \u0027faq_autoprocess\u0027\n    }\n  });\n}\n\nreturn chunks;"
                                     },
