                  {
                      "parameters":  {
                                         "jsCode":  "const embeddingItems = $input.all();\nconst chunkItems = $(\u0027Нарезка на чанки\u0027).all();\n\nif (embeddingItems.length !== chunkItems.length) {\n  throw new Error(\n    `Количество эмбеддингов (${embeddingItems.length}) ` +\n    `не совпадает с количеством чанков (${chunkItems.length})`\n  );\n}\n\nconst points = embeddingItems.map((item, index) =\u003e {\n  const vector = item.json.data?.[0]?.embedding;\n  const chunk = chunkItems[index].json;\n\n  if (!Array.isArray(vector)) {\n    throw new Error(`У чанка ${chunk.chunk_id} отсутствует embedding`);\n  }\n\n  if (vector.length !== 2560) {\n    throw new Error(\n      `Размер вектора чанка ${chunk.chunk_id}: ${vector.length}, ожидалось 2560`\n    );\n  }\n\n  return {\n    id: chunk.chunk_id,\n    vector: vector.map(Number),\n    payload: {\n      chunk_id: chunk.chunk_id,\n      text: chunk.chunk_text,\n      source: chunk.source\n    }\n  };\n});\n\nreturn [{\n  json: {\n    points,\n    check: {\n      points_count: points.length,\n      vector_size: points[0]?.vector.length ?? 0\n    }\n  }\n}];"
                                     },
                      "type":  "n8n-nodes-base.code",
