                  },
                  {
                      "parameters":  {
                                         "promptType":  "define",
                                         "text":  "=Ты — помощник сервиса «АвтоПроцесс».\n\nОтвечай только на основании предоставленного контекста.\nНе используй внешние знания и ничего не придумывай.\n\nЕсли в контексте нет ответа, напиши точно:\n«В документе нет информации для ответа на этот вопрос.»\n\nОтвет дай кратко и на русском языке.\n\nВОПРОС:\n{{ $json.question }}\n\nКОНТЕКСТ:\n{{ $json.context }}",
                                         "batching":  {

