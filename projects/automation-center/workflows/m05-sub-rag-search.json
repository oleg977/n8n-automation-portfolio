    {
      "parameters": {
        "jsCode": "const points = $input.first().json.result?.points ?? [];\nconst prepared = $('Start').first().json;\n\nconst context = points\n  .map((point, index) => {\n    const text = point.payload?.text ?? '';\n    const score = Number(point.score ?? 0).toFixed(3);\n\n    return `Фрагмент ${index + 1}, близость ${score}:\\n${text}`;\n  })\n  .join('\\n\\n---\\n\\n');\n\nreturn [{\n  json: {\n    question: prepared.question,\n    context,\n    matches_count: points.length,\n    best_score: points[0]?.score ?? 0\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1072,
        272
      ],
      "id": "4d530eec-3482-4088-b085-ef5119c1099c",
      "name": "Подготовить контекст"
    },
    {
      "parameters": {
        "jsCode": "const vector = $input.first().json.data?.[0]?.embedding;\nconst prepared = $('Start').first().json;\n\nif (!Array.isArray(vector)) {\n  throw new Error('Эмбеддинг вопроса не найден');\n}\n\nif (vector.length !== 2560) {\n  throw new Error(\n    `Размер вектора: ${vector.length}, ожидалось 2560`\n  );\n}\n\nreturn [{\n  json: {\n    question: prepared.question,\n    query: vector.map(Number),\n    limit: 3,\n    with_payload: true,\n    with_vector: false\n  }\n}];"
      },
